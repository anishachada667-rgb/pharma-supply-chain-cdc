FROM apache/airflow:3.1.7-python3.11

USER root
RUN mkdir -p /opt/dbt-venv \
    && chown airflow:0 /opt/dbt-venv

USER airflow
RUN python -m venv /opt/dbt-venv \
    && PIP_USER=false /opt/dbt-venv/bin/python -m pip install \
       --no-cache-dir \
       "dbt-core==1.12.5" \
       "dbt-postgres==1.11.0" \
       "confluent-kafka>=2.6,<3" \
       "psycopg[binary]>=3.2,<4"